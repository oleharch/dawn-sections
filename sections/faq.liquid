{%- comment -%}
  FAQ
  Accordion on native <details>/<summary>: keyboard and screen-reader friendly without JavaScript.
  "Open one at a time" uses the `name` attribute (exclusive accordion, Chrome 120+, Safari 17.2+,
  Firefox 130+; older browsers simply allow several open items).
  Optional FAQPage JSON-LD for rich results in Google.

  Files: sections/faq.liquid
{%- endcomment -%}

{%- style -%}
  #faq-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 1.5rem {{ section.settings.padding_bottom }}px;
  }
  #faq-{{ section.id }} .faq__inner { max-width: {{ section.settings.max_width }}rem; margin: 0 auto; }
  #faq-{{ section.id }} .faq__heading { margin: 0 0 1rem; font-size: 2.8rem; line-height: 1.2; text-align: {{ section.settings.text_align }}; }
  #faq-{{ section.id }} .faq__description { margin: 0 0 2.4rem; font-size: 1.6rem; line-height: 1.5; text-align: {{ section.settings.text_align }}; }
  #faq-{{ section.id }} .faq__item { border-top: 0.1rem solid rgba(var(--color-foreground, 18, 18, 18), 0.15); }
  #faq-{{ section.id }} .faq__item:last-child { border-bottom: 0.1rem solid rgba(var(--color-foreground, 18, 18, 18), 0.15); }
  #faq-{{ section.id }} .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    padding: 1.6rem 0;
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }
  #faq-{{ section.id }} .faq__question::-webkit-details-marker { display: none; }
  #faq-{{ section.id }} .faq__question:focus-visible { outline: 0.2rem solid currentColor; outline-offset: 0.3rem; }
  #faq-{{ section.id }} .faq__icon {
    flex: 0 0 auto;
    width: 1.2rem;
    height: 1.2rem;
    position: relative;
  }
  #faq-{{ section.id }} .faq__icon::before,
  #faq-{{ section.id }} .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 0.2rem;
    background: currentColor;
    transform: translateY(-50%);
    transition: transform 0.2s ease;
  }
  #faq-{{ section.id }} .faq__icon::after { transform: translateY(-50%) rotate(90deg); }
  #faq-{{ section.id }} .faq__item[open] .faq__icon::after { transform: translateY(-50%) rotate(0); }
  #faq-{{ section.id }} .faq__answer { padding: 0 3rem 1.8rem 0; font-size: 1.5rem; line-height: 1.6; }
  #faq-{{ section.id }} .faq__answer > :first-child { margin-top: 0; }
  #faq-{{ section.id }} .faq__answer > :last-child { margin-bottom: 0; }
  @supports (interpolate-size: allow-keywords) {
    #faq-{{ section.id }} .faq__item { interpolate-size: allow-keywords; }
    #faq-{{ section.id }} .faq__item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 0.25s ease, content-visibility 0.25s allow-discrete;
    }
    #faq-{{ section.id }} .faq__item[open]::details-content { block-size: auto; }
  }
  @media (max-width: 749px) {
    #faq-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px; }
    #faq-{{ section.id }} .faq__heading { font-size: 2.2rem; }
    #faq-{{ section.id }} .faq__question { font-size: 1.5rem; }
  }
{%- endstyle -%}

<div id="faq-{{ section.id }}" class="faq color-{{ section.settings.color_scheme }}">
  <div class="faq__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="faq__description">{{ section.settings.description }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.settings.question == blank -%}{% continue %}{%- endif -%}
      <details
        class="faq__item"
        {% if section.settings.open_one %}name="faq-{{ section.id }}"{% endif %}
        {% if section.settings.open_first and forloop.first %}open{% endif %}
        {{ block.shopify_attributes }}
      >
        <summary class="faq__question">
          <span>{{ block.settings.question | escape }}</span>
          <span class="faq__icon" aria-hidden="true"></span>
        </summary>
        <div class="faq__answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- if block.settings.question == blank -%}{% continue %}{%- endif -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 50,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "open_one",
      "label": "Open one question at a time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Add FAQPage structured data (JSON-LD)",
      "info": "Helps Google show the questions as rich results. Use on one FAQ per page.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does delivery take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Orders ship within 1-2 business days. Delivery takes 3-5 business days.</p>"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "item" },
        {
          "type": "item",
          "settings": {
            "question": "Can I return an item?",
            "answer": "<p>Yes, within 30 days of delivery. The item must be unused and in its original packaging.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>We ship to most countries. Shipping options and costs are shown at checkout.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
