{%- comment -%}
  Sticky add to cart
  A bar that appears when the main product form scrolls out of view.
  Submits the real product form, so the theme's cart drawer, notification and
  error handling keep working. Follows the selected variant (price, availability, image).

  Files: sections/sticky-add-to-cart.liquid, assets/sticky-add-to-cart.js
  Works with Dawn 10+ (pub/sub variant events) and falls back to the form's own
  change events on any other Online Store 2.0 theme.
{%- endcomment -%}

<script src="{{ 'sticky-add-to-cart.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign show_on_desktop = section.settings.show_on_desktop
  assign show_on_mobile = section.settings.show_on_mobile
-%}

{%- style -%}
  #sticky-atc-{{ section.id }} {
    --sticky-atc-bg: {{ section.settings.background_color }};
    --sticky-atc-text: {{ section.settings.text_color }};
    --sticky-atc-button-bg: {{ section.settings.button_background }};
    --sticky-atc-button-text: {{ section.settings.button_text_color }};
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: none;
    transform: translateY(100%);
    transition: transform 0.3s ease;
    background: var(--sticky-atc-bg);
    color: var(--sticky-atc-text);
    box-shadow: 0 -0.4rem 2rem rgba(0, 0, 0, 0.12);
    padding-bottom: env(safe-area-inset-bottom);
  }
  #sticky-atc-{{ section.id }}.sticky-atc--visible { transform: none; }
  #sticky-atc-{{ section.id }} .sticky-atc__inner {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    max-width: 120rem;
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }
  #sticky-atc-{{ section.id }} .sticky-atc__image {
    flex: 0 0 auto;
    width: 4.8rem;
    height: 4.8rem;
    object-fit: cover;
    border-radius: 0.4rem;
  }
  #sticky-atc-{{ section.id }} .sticky-atc__info { flex: 1 1 auto; min-width: 0; }
  #sticky-atc-{{ section.id }} .sticky-atc__title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #sticky-atc-{{ section.id }} .sticky-atc__meta {
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  #sticky-atc-{{ section.id }} .sticky-atc__variant { opacity: 0.7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #sticky-atc-{{ section.id }} .sticky-atc__compare { text-decoration: line-through; opacity: 0.6; }
  #sticky-atc-{{ section.id }} .sticky-atc__button {
    flex: 0 0 auto;
    padding: 1.2rem 2rem;
    border: 0;
    border-radius: 0.6rem;
    background: var(--sticky-atc-button-bg);
    color: var(--sticky-atc-button-text);
    font: inherit;
    font-size: 1.4rem;
    cursor: pointer;
  }
  #sticky-atc-{{ section.id }} .sticky-atc__button[disabled] { opacity: 0.5; cursor: not-allowed; }
  #sticky-atc-{{ section.id }} .sticky-atc__button:focus-visible { outline: 0.2rem solid var(--sticky-atc-text); outline-offset: 0.2rem; }
  @media (max-width: 749px) {
    {%- if show_on_mobile -%}#sticky-atc-{{ section.id }} { display: block; }{%- endif -%}
    #sticky-atc-{{ section.id }} .sticky-atc__variant { display: none; }
  }
  @media (min-width: 750px) {
    {%- if show_on_desktop -%}#sticky-atc-{{ section.id }} { display: block; }{%- endif -%}
  }
{%- endstyle -%}

{%- if product != blank -%}
<sticky-add-to-cart
  id="sticky-atc-{{ section.id }}"
  class="sticky-atc"
  data-sold-out-label="{{ section.settings.sold_out_label | default: 'Sold out' | escape }}"
  data-add-label="{{ section.settings.button_label | default: 'Add to cart' | escape }}"
  data-current-variant="{{ current_variant.id }}"
  aria-hidden="true"
>
  <div class="sticky-atc__inner">
    {%- if section.settings.show_image -%}
      {%- liquid
        assign image = current_variant.featured_image | default: product.featured_image
      -%}
      {%- if image != blank -%}
        {{ image | image_url: width: 96 | image_tag: class: 'sticky-atc__image', widths: '48, 96', loading: 'lazy', alt: '', data-sticky-atc-image: '' }}
      {%- endif -%}
    {%- endif -%}

    <div class="sticky-atc__info">
      <p class="sticky-atc__title">{{ product.title | escape }}</p>
      <div class="sticky-atc__meta">
        {%- if section.settings.show_price -%}
          <span data-sticky-atc-price>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <s class="sticky-atc__compare">{{ current_variant.compare_at_price | money }}</s>
            {%- endif -%}
            <span class="sticky-atc__price">{{ current_variant.price | money }}</span>
          </span>
        {%- endif -%}
        {%- if product.has_only_default_variant == false -%}
          <span class="sticky-atc__variant" data-sticky-atc-variant>{{ current_variant.title | escape }}</span>
        {%- endif -%}
      </div>
    </div>

    <button
      type="submit"
      class="sticky-atc__button"
      data-sticky-atc-button
      {% unless current_variant.available %}disabled{% endunless %}
    >
      {%- if current_variant.available -%}
        {{ section.settings.button_label | default: 'Add to cart' | escape }}
      {%- else -%}
        {{ section.settings.sold_out_label | default: 'Sold out' | escape }}
      {%- endif -%}
    </button>
  </div>

  {%- comment -%} Variant data rendered once in Liquid, so prices are formatted by the shop, not by JS. {%- endcomment -%}
  <script type="application/json" data-sticky-atc-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "available": {{ variant.available }},
          "price": {{ variant.price | money | json }},
          "compare_at_price": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 96 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</sticky-add-to-cart>
{%- endif -%}

{% schema %}
{
  "name": "Sticky add to cart",
  "tag": "section",
  "class": "section-sticky-add-to-cart",
  "limit": 1,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Appears when the main Add to cart button scrolls out of view. Add it anywhere on the product template."
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Sticky add to cart"
    }
  ]
}
{% endschema %}
