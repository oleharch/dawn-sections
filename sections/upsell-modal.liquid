{%- comment -%}
  Upsell modal
  Opens after a product is added to the cart and offers related or complementary products.
  Recommendations come from the Product Recommendations API rendered through the Section Rendering
  API, so prices, images and variants are formatted by Liquid, not rebuilt in JavaScript.
  Products added from the modal go through the Ajax Cart API with the `sections` parameter, so the
  theme's cart drawer or cart notification updates the same way as from the product form.

  Files: sections/upsell-modal.liquid, assets/upsell-modal.js
  Add it to the Header or Footer section group so it is available on every page.

  Docs:
  - Product recommendations: https://shopify.dev/docs/api/ajax/reference/product-recommendations
  - Section Rendering API:   https://shopify.dev/docs/api/ajax/section-rendering
  - Cart API (sections):     https://shopify.dev/docs/api/ajax/reference/cart#post-locale-cart-add-js
{%- endcomment -%}

<script src="{{ 'upsell-modal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign source = section.settings.source
  assign limit = section.settings.limit
  if recommendations.performed
    assign products = recommendations.products
  elsif source == 'manual'
    assign products = section.settings.product_list
  endif
-%}

{%- style -%}
  #upsell-modal-{{ section.id }} {
    --upsell-bg: {{ section.settings.background_color }};
    --upsell-text: {{ section.settings.text_color }};
    --upsell-button-bg: {{ section.settings.button_background }};
    --upsell-button-text: {{ section.settings.button_text_color }};
    --upsell-border: {{ section.settings.text_color | color_modify: 'alpha', 0.15 }};
  }
  #upsell-modal-{{ section.id }} .upsell-modal__dialog {
    width: min(92vw, 72rem);
    max-height: 90vh;
    padding: 0;
    border: 0;
    border-radius: 1.2rem;
    background: var(--upsell-bg);
    color: var(--upsell-text);
    box-shadow: 0 2rem 6rem rgba(0, 0, 0, 0.3);
  }
  #upsell-modal-{{ section.id }} .upsell-modal__dialog::backdrop { background: rgba(0, 0, 0, 0.55); }
  #upsell-modal-{{ section.id }} .upsell-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 2.4rem 1.2rem;
  }
  #upsell-modal-{{ section.id }} .upsell-modal__heading { margin: 0; font-size: 2rem; line-height: 1.2; }
  #upsell-modal-{{ section.id }} .upsell-modal__close {
    width: 3.6rem;
    height: 3.6rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }
  #upsell-modal-{{ section.id }} .upsell-modal__close:focus-visible,
  #upsell-modal-{{ section.id }} .upsell-modal__button:focus-visible,
  #upsell-modal-{{ section.id }} .upsell-modal__link:focus-visible { outline: 0.2rem solid currentColor; outline-offset: 0.2rem; }
  #upsell-modal-{{ section.id }} .upsell-modal__added {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin: 0 2.4rem;
    padding: 1.2rem 0;
    border-top: 0.1rem solid var(--upsell-border);
    border-bottom: 0.1rem solid var(--upsell-border);
  }
  #upsell-modal-{{ section.id }} .upsell-modal__added[hidden] { display: none; }
  #upsell-modal-{{ section.id }} .upsell-modal__added-image { width: 6.4rem; height: 6.4rem; object-fit: cover; border-radius: 0.6rem; }
  #upsell-modal-{{ section.id }} .upsell-modal__added-title { margin: 0; font-weight: 600; }
  #upsell-modal-{{ section.id }} .upsell-modal__added-meta { margin: 0.2rem 0 0; font-size: 1.3rem; opacity: 0.75; }
  #upsell-modal-{{ section.id }} .upsell-modal__subheading { margin: 2rem 2.4rem 1.2rem; font-size: 1.5rem; font-weight: 600; }
  #upsell-modal-{{ section.id }} .upsell-modal__products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.6rem;
    margin: 0;
    padding: 0 2.4rem;
    list-style: none;
    overflow: auto;
    max-height: 48vh;
  }
  #upsell-modal-{{ section.id }} .upsell-modal__card { display: flex; flex-direction: column; gap: 0.8rem; }
  #upsell-modal-{{ section.id }} .upsell-modal__card-image { aspect-ratio: 1; width: 100%; object-fit: cover; border-radius: 0.6rem; background: rgba(0, 0, 0, 0.04); }
  #upsell-modal-{{ section.id }} .upsell-modal__card-title { margin: 0; font-size: 1.4rem; line-height: 1.3; }
  #upsell-modal-{{ section.id }} .upsell-modal__card-title a { color: inherit; text-decoration: none; }
  #upsell-modal-{{ section.id }} .upsell-modal__card-price { font-size: 1.4rem; }
  #upsell-modal-{{ section.id }} .upsell-modal__card-price s { opacity: 0.6; margin-right: 0.4rem; }
  #upsell-modal-{{ section.id }} .upsell-modal__select {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 0.1rem solid var(--upsell-border);
    border-radius: 0.4rem;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1.3rem;
  }
  #upsell-modal-{{ section.id }} .upsell-modal__button {
    margin-top: auto;
    padding: 1rem 1.2rem;
    border: 0.1rem solid var(--upsell-button-bg);
    border-radius: 0.6rem;
    background: var(--upsell-button-bg);
    color: var(--upsell-button-text);
    font: inherit;
    font-size: 1.4rem;
    cursor: pointer;
  }
  #upsell-modal-{{ section.id }} .upsell-modal__button[disabled] { opacity: 0.5; cursor: not-allowed; }
  #upsell-modal-{{ section.id }} .upsell-modal__button--secondary { background: transparent; color: var(--upsell-text); border-color: currentColor; }
  #upsell-modal-{{ section.id }} .upsell-modal__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: flex-end;
    padding: 2rem 2.4rem 2.4rem;
  }
  #upsell-modal-{{ section.id }} .upsell-modal__link {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.6rem;
    border-radius: 0.6rem;
    background: var(--upsell-button-bg);
    color: var(--upsell-button-text);
    font-size: 1.4rem;
    text-decoration: none;
  }
  #upsell-modal-{{ section.id }} .upsell-modal__error { margin: 0.4rem 0 0; font-size: 1.2rem; color: #c00; }
  @media (max-width: 749px) {
    #upsell-modal-{{ section.id }} .upsell-modal__products { grid-template-columns: repeat(2, 1fr); }
    #upsell-modal-{{ section.id }} .upsell-modal__footer { justify-content: stretch; }
    #upsell-modal-{{ section.id }} .upsell-modal__footer > * { flex: 1 1 100%; justify-content: center; text-align: center; }
  }
{%- endstyle -%}

<upsell-modal
  id="upsell-modal-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-source="{{ source }}"
  data-recommendations-url="{{ routes.product_recommendations_url }}?limit={{ limit }}&intent={{ source }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-once-per-session="{{ section.settings.once_per_session }}"
  data-design-mode="{{ request.design_mode }}"
>
  <dialog class="upsell-modal__dialog" aria-labelledby="upsell-modal-heading-{{ section.id }}">
    <div class="upsell-modal__header">
      <h2 class="upsell-modal__heading" id="upsell-modal-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <button type="button" class="upsell-modal__close" aria-label="{{ section.settings.close_label | default: 'Close' | escape }}" data-upsell-close>&times;</button>
    </div>

    {%- if section.settings.show_added_product -%}
      <div class="upsell-modal__added" data-upsell-added hidden>
        <img class="upsell-modal__added-image" alt="" width="64" height="64" data-upsell-added-image>
        <div>
          <p class="upsell-modal__added-title" data-upsell-added-title></p>
          <p class="upsell-modal__added-meta" data-upsell-added-meta></p>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="upsell-modal__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <ul class="upsell-modal__products" data-upsell-products>
      {%- for product in products limit: limit -%}
        {%- liquid
          assign variant = product.selected_or_first_available_variant
          assign image = product.featured_image
        -%}
        <li class="upsell-modal__card" data-upsell-card>
          {%- if image != blank -%}
            <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {{ image | image_url: width: 400 | image_tag: class: 'upsell-modal__card-image', widths: '200, 400', loading: 'lazy', alt: '' }}
            </a>
          {%- endif -%}
          <h3 class="upsell-modal__card-title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
          <div class="upsell-modal__card-price" data-upsell-price>
            {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
            <span>{{ variant.price | money }}</span>
          </div>
          <form method="post" action="{{ routes.cart_add_url }}" data-upsell-form>
            {%- if product.has_only_default_variant -%}
              <input type="hidden" name="id" value="{{ variant.id }}">
            {%- else -%}
              <select class="upsell-modal__select" name="id" aria-label="{{ product.title | escape }}">
                {%- for v in product.variants -%}
                  <option
                    value="{{ v.id }}"
                    {% if v == variant %}selected{% endif %}
                    {% unless v.available %}disabled{% endunless %}
                    data-price="{{ v.price | money | escape }}"
                    data-compare-at-price="{% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | escape }}{% endif %}"
                  >
                    {{ v.title | escape }}{% unless v.available %} ({{ section.settings.sold_out_label | default: 'Sold out' | escape }}){% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="upsell-modal__button" {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}{{ section.settings.add_label | default: 'Add' | escape }}{%- else -%}{{ section.settings.sold_out_label | default: 'Sold out' | escape }}{%- endif -%}
            </button>
            <p class="upsell-modal__error" role="alert" data-upsell-error hidden></p>
          </form>
        </li>
      {%- endfor -%}
    </ul>

    <div class="upsell-modal__footer">
      <button type="button" class="upsell-modal__button upsell-modal__button--secondary" data-upsell-close>
        {{ section.settings.continue_label | default: 'Continue shopping' | escape }}
      </button>
      <a href="{{ routes.cart_url }}" class="upsell-modal__link">{{ section.settings.cart_label | default: 'View cart' | escape }}</a>
    </div>
  </dialog>
</upsell-modal>

{% schema %}
{
  "name": "Upsell modal",
  "tag": "section",
  "class": "section-upsell-modal",
  "limit": 1,
  "enabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Opens after a product is added to the cart. In the theme editor it opens when this section is selected."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Products to offer",
      "options": [
        { "value": "complementary", "label": "Complementary (Shopify recommendations)" },
        { "value": "related", "label": "Related (Shopify recommendations)" },
        { "value": "manual", "label": "Manual list" }
      ],
      "default": "related",
      "info": "Complementary products need the Shopify Search & Discovery app. Without it the list falls back to related products."
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Manual list",
      "limit": 6
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_added_product",
      "label": "Show the added product",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "once_per_session",
      "label": "Show once per session",
      "default": false
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Added to your cart"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Goes well with"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add button",
      "default": "Add"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Continue button",
      "default": "Continue shopping"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart button",
      "default": "View cart"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close button (screen readers)",
      "default": "Close"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Upsell modal"
    }
  ]
}
{% endschema %}
